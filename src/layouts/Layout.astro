---
// src/layouts/Layout.astro
import '../styles/theme.css';
import { ThemeManager } from '../modules/theme/ThemeManager';

interface Props {
  title?: string;
}

const { title = 'GNU Octave WebAssembly UI' } = Astro.props;
const antiFlashScript = ThemeManager.getAntiFlashScript();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GNU Octave 11.3.0 纯客户端 WebAssembly (Wasm64 + Pthreads) 交互前端" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- 防闪烁内联脚本：在 DOM 绘制前确定主题 -->
    <script is:inline set:html={antiFlashScript} />

    <!-- 静态引入上游胶水脚本（直通 public/bridge/，不经 Vite 打包混淆） -->
    <script is:inline src="/bridge/assets-loader.js"></script>
    <script is:inline src="/bridge/queue.js"></script>
    <script is:inline src="/bridge/p5canvas.js"></script>
    <script is:inline src="/bridge/webaudio.js"></script>
    <script is:inline src="/bridge/webaudiorec.js"></script>
    <script is:inline src="/bridge/webfilepick.js"></script>
    <script is:inline src="/bridge/webnet.js"></script>
    <script is:inline src="/bridge/octave-core.js"></script>
    <script is:inline src="/bridge/octave-page.js"></script>
    <script is:inline src="/bridge/octave-embed.js"></script>
    <script is:inline src="/bridge/lanes.js"></script>
    <script is:inline src="/bridge/lane.js"></script>
    <script is:inline>
      if (typeof window !== 'undefined' && typeof octaveLaneFiles === 'function' && typeof octaveLaneState !== 'undefined') {
        window.__octaveLanePlan = octaveLaneFiles(octaveLaneState.lane);
      }
    </script>
    <script is:inline src="/bridge/w64/octave.js"></script>
  </head>
  <body>
    <!-- 全局隐藏输出挂点，供 OctaveEmbed 接收解释器标准输出流（hidden #octave-raw-output pre） -->
    <div id="octave-raw-output"><pre></pre></div>

    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100vw;
    height: 100vh;
  }
</style>
