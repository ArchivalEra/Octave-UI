#!/bin/sh
# pre-commit：上游 Einfacht gate.py（重渲染 + registry）+ 本仓 22 道领域闸门。
#
# ★ 2026-11-07「额叶切除」：机制层整层换成上游 Einfacht b580052。
#   上游 gate.py 只做「重渲染 + registry --run commit」，而本仓 22 道领域判据
#   （S1-S9 / 三路同轴 / 零手写选项 / 下载装载解耦 / wayfinder / 三语 README）
#   因新版 check_i18n 本体零语言制度移到 gates/ 目录，脱离 registry 发现式名录。
#   ⇒ 本壳 = 上游 gate.py commit 相位（唯一产地）+ 本仓领域闸门逐道执行，
#     两者都不重复实现。
#
#   gates/ 下的闸门仍 import gate/ledger/render/living/runner（新版这些符号全在、
#   签名兼容），由 PYTHONPATH 指向 zreflect/ 提供；领域闸门文件本身零改动。
set -e
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(CDPATH= cd -- "$HERE/.." && pwd)

# ① 上游机制：重渲染机器块 + 跑 registry 全部闸门（唯一产地）
python3 "$HERE/gate.py" commit "$REPO" || exit 1

# ② 本仓 22 道领域闸门：自证（判据有牙）+ 真实执行（当前产物合规）
echo "── gates/ 领域闸门（22 道）──"
cd "$REPO"
export PYTHONPATH="$REPO/zreflect${PYTHONPATH:+:$PYTHONPATH}"
ran=0
for g in gates/check_*.py; do
  [ -f "$g" ] || continue
  python3 "$g" --selftest >/dev/null || { echo "FATAL: $g --selftest 失败"; exit 1; }
  out=$(python3 "$g" 2>&1) || {
    echo "FATAL: $g 执行失败"; echo "$out" | head -12; exit 1;
  }
  printf '%s\n' "$out" | grep -q '^OFF:' && { ran=$((ran+1)); continue; }
  ran=$((ran+1))
done
echo "OK（22 道领域闸门：自证 + 执行，ran=$ran）"
